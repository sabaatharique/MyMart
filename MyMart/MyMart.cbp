<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="MyMart" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/MyMart" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/MyMart" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="include/cashier.h" />
		<Unit filename="include/customer.h" />
		<Unit filename="include/database.h" />
		<Unit filename="include/employee.h" />
		<Unit filename="include/perishableproducts.h" />
		<Unit filename="include/product.h" />
		<Unit filename="include/sqlite3.h" />
		<Unit filename="include/stockclerk.h" />
		<Unit filename="main.cpp" />
		<Unit filename="src/cashier.cpp" />
		<Unit filename="src/customer.cpp" />
		<Unit filename="src/database.cpp" />
		<Unit filename="src/employee.cpp" />
		<Unit filename="src/perishableproducts.cpp" />
		<Unit filename="src/product.cpp" />
		<Unit filename="src/sqlite3.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/stockclerk.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
